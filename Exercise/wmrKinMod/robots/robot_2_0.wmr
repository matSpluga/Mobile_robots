% Differential drive robot
% The (2,0) robot as in document Model_robot_2_0.pdf
% L: wheel offset, alpha: orientation, etc.

R  L    alpha     d    beta     gamma    phi

r   a    -pi/2    0      0       pi/2   phi_1f   % right wheel
r   a     pi/2    0      0      -pi/2   phi_2f   % left wheel
r   b     pi      c    beta_3      0    phi_3c